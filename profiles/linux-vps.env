# HyperFrames Lite: 1.5-vCPU Linux VPS profile.
# Target VPS: 6 GB physical RAM, about 4 GB normally available.
# Auto mode enables Low Memory Mode when available headroom is <= 4.5 GiB.

HF_LITE_WORKERS=1
HF_LITE_CAPTURE_MODE=auto
HF_LITE_LOW_MEMORY_MODE=auto
HF_LITE_CPU_BUDGET=1.5

# Preserve upstream defaults for quality, FPS, resolution, codec and audio.
# Do not set CRF, bitrate, FPS, scale, motion blur or transition flags here.
